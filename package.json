{
  "name": "superstep-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/react",
    "sdk/typescript"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=@superstep/sdk && npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build --workspace=@superstep/react && npm test --workspaces --if-present",
    "test:e2e": "npm run e2e --workspace=frontend"
  }
}
