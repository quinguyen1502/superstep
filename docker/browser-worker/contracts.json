            "type": "string"
          },
          "server": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Server"
          },
          "auth": {
            "default": "none",
            "enum": [
              "none",
              "basic"
            ],
            "title": "Auth",
            "type": "string"
          }
        },
        "title": "ProxySettings",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1,
        "default": 1,
        "title": "Version",
        "type": "integer"
      },
      "context": {
        "$ref": "#/$defs/ExecutionContext"
      },
      "settings": {
        "$ref": "#/$defs/BrowserSettings"
      },
      "session_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Session Id",
        "type": "string"
      },
      "generation": {
        "default": 1,
        "minimum": 1,
        "title": "Generation",
        "type": "integer"
      },
      "profile_seed": {
        "anyOf": [
          {
            "$ref": "#/$defs/ProfileSeed"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "context",
      "settings",
      "session_id"
    ],
    "title": "WorkerOpen",
    "type": "object"
  },
