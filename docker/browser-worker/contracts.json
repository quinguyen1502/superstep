            "type": "boolean"
          },
          "allow_evaluate_js": {
            "default": false,
            "title": "Allow Evaluate Js",
            "type": "boolean"
          },
          "allow_upload": {
            "default": false,
            "title": "Allow Upload",
            "type": "boolean"
          },
          "allow_download": {
            "default": false,
            "title": "Allow Download",
            "type": "boolean"
          },
          "download_max_bytes": {
            "default": 10485760,
            "maximum": 52428800,
            "minimum": 1024,
            "title": "Download Max Bytes",
            "type": "integer"
          },
          "download_allowed_types": {
            "items": {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&\\-^_+.]+/[A-Za-z0-9][A-Za-z0-9!#$&\\-^_+.]+$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Download Allowed Types",
            "type": "array"
          },
          "stealth": {
            "default": false,
            "title": "Stealth",
            "type": "boolean"
          }
        },
        "required": [
          "allowed_origins"
        ],
        "title": "BrowserSettings",
        "type": "object"
      },
      "ExecutionContext": {
        "additionalProperties": false,
        "properties": {
          "principal_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Principal Id",
            "type": "string"
          },
          "conversation_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Conversation Id"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "group_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Group Id",
            "type": "string"
          },
          "connection_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Connection Id",
            "type": "string"
          },
          "configuration": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Configuration",
            "type": "string"
          },
          "lease_generation": {
            "minimum": 1,
            "title": "Lease Generation",
            "type": "integer"
          }
        },
        "required": [
          "principal_id",
          "run_id",
          "group_id",
          "connection_id",
          "configuration",
          "lease_generation"
        ],
        "title": "ExecutionContext",
        "type": "object"
      },
      "ProfileCookie": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
            "title": "Name",
            "type": "string"
          },
          "value": {
            "maxLength": 4096,
            "title": "Value",
            "type": "string"
          },
          "domain": {
            "maxLength": 253,
            "minLength": 1,
            "title": "Domain",
            "type": "string"
          },
          "path": {
            "default": "/",
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^/[^\\r\\n]*$",
            "title": "Path",
            "type": "string"
          },
          "expires": {
            "default": -1.0,
            "maximum": 253402300799,
            "minimum": -1,
            "title": "Expires",
            "type": "number"
          },
          "httpOnly": {
            "default": true,
            "title": "Httponly",
            "type": "boolean"
          },
          "secure": {
            "const": true,
            "default": true,
            "title": "Secure",
            "type": "boolean"
          },
          "sameSite": {
            "default": "Lax",
            "enum": [
              "Strict",
              "Lax",
              "None"
            ],
            "title": "Samesite",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value",
          "domain"
        ],
        "title": "ProfileCookie",
        "type": "object"
      },
      "ProfileOrigin": {
        "additionalProperties": false,
        "properties": {
          "origin": {
            "maxLength": 2048,
            "minLength": 1,
