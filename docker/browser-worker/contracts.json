            "$ref": "#/$defs/ProfileState"
          }
        },
        "required": [
          "principal_id",
          "state"
        ],
        "title": "ProfileSeed",
        "type": "object"
      },
      "ProfileSettings": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Name",
            "type": "string"
          },
          "origins": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Origins",
            "type": "array"
          }
        },
        "required": [
          "name",
          "origins"
        ],
        "title": "ProfileSettings",
        "type": "object"
      },
      "ProfileState": {
        "additionalProperties": false,
        "properties": {
          "cookies": {
            "items": {
              "$ref": "#/$defs/ProfileCookie"
            },
            "maxItems": 100,
            "title": "Cookies",
            "type": "array"
          },
          "origins": {
            "items": {
              "$ref": "#/$defs/ProfileOrigin"
            },
            "maxItems": 20,
            "title": "Origins",
            "type": "array"
          }
        },
        "title": "ProfileState",
        "type": "object"
      },
      "ProfileStorageItem": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "value": {
            "maxLength": 4096,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "title": "ProfileStorageItem",
        "type": "object"
      },
      "ProxySettings": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "direct",
            "enum": [
              "direct",
              "operator_default",
              "custom"
            ],
