          "idle_timeout_s": {
            "default": 1800,
            "maximum": 7200,
            "minimum": 60,
            "title": "Idle Timeout S",
            "type": "integer"
          },
          "lifetime_s": {
            "default": 3600,
            "maximum": 14400,
            "minimum": 120,
