  "WorkerArtifact": {
    "$defs": {
      "ExecutionContext": {
        "additionalProperties": false,
        "properties": {
          "principal_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Principal Id",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "group_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Group Id",
            "type": "string"
          },
          "connection_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Connection Id",
            "type": "string"
          },
          "configuration": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Configuration",
            "type": "string"
          },
          "lease_generation": {
            "minimum": 1,
            "title": "Lease Generation",
            "type": "integer"
          }
        },
        "required": [
          "principal_id",
          "run_id",
          "group_id",
          "connection_id",
          "configuration",
          "lease_generation"
        ],
        "title": "ExecutionContext",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1,
