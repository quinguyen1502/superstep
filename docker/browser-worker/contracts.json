{
  "WorkerCommand": {
    "$defs": {
      "ExecutionContext": {
        "additionalProperties": false,
        "properties": {
          "principal_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Principal Id",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "group_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Group Id",
            "type": "string"
          },
          "connection_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Connection Id",
            "type": "string"
          },
          "configuration": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Configuration",
            "type": "string"
          },
          "lease_generation": {
            "minimum": 1,
            "title": "Lease Generation",
            "type": "integer"
          }
        },
        "required": [
          "principal_id",
          "run_id",
          "group_id",
          "connection_id",
          "configuration",
          "lease_generation"
        ],
        "title": "ExecutionContext",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1,
        "default": 1,
        "title": "Version",
        "type": "integer"
      },
      "context": {
        "$ref": "#/$defs/ExecutionContext"
      },
      "session_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Session Id",
        "type": "string"
      },
      "generation": {
        "minimum": 1,
        "title": "Generation",
        "type": "integer"
      },
      "sequence": {
        "minimum": 0,
        "title": "Sequence",
        "type": "integer"
      },
      "command_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Command Id",
        "type": "string"
      },
      "operation": {
        "enum": [
          "navigate",
          "snapshot",
          "click",
          "fill",
          "extract",
          "screenshot"
        ],
        "title": "Operation",
        "type": "string"
      },
      "arguments": {
        "additionalProperties": true,
        "title": "Arguments",
        "type": "object"
      },
      "timeout_ms": {
        "default": 30000,
        "maximum": 60000,
        "minimum": 1000,
        "title": "Timeout Ms",
        "type": "integer"
      }
    },
    "required": [
      "context",
      "session_id",
      "generation",
      "sequence",
      "command_id",
      "operation",
      "arguments"
    ],
    "title": "WorkerCommand",
    "type": "object"
  },
  "WorkerOpen": {
    "$defs": {
      "BrowserSettings": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "provider": {
            "default": "local",
            "enum": [
              "local",
              "controlled_cdp"
            ],
            "title": "Provider",
            "type": "string"
          },
          "proxy": {
            "$ref": "#/$defs/ProxySettings"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/$defs/ProfileSettings"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "allowed_origins": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Allowed Origins",
            "type": "array"
          },
          "action_timeout_ms": {
            "default": 30000,
            "maximum": 60000,
            "minimum": 1000,
            "title": "Action Timeout Ms",
            "type": "integer"
          },
          "idle_timeout_s": {
            "default": 120,
            "maximum": 600,
            "minimum": 30,
            "title": "Idle Timeout S",
            "type": "integer"
          },
          "lifetime_s": {
            "default": 600,
            "maximum": 1800,
            "minimum": 30,
            "title": "Lifetime S",
            "type": "integer"
          },
          "max_actions": {
            "default": 12,
            "maximum": 100,
            "minimum": 1,
            "title": "Max Actions",
            "type": "integer"
          },
          "stealth": {
            "const": false,
            "default": false,
            "title": "Stealth",
            "type": "boolean"
          }
        },
        "title": "BrowserSettings",
        "type": "object"
      },
      "ExecutionContext": {
        "additionalProperties": false,
        "properties": {
          "principal_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Principal Id",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "group_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Group Id",
            "type": "string"
          },
          "connection_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Connection Id",
            "type": "string"
          },
          "configuration": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Configuration",
            "type": "string"
          },
          "lease_generation": {
            "minimum": 1,
            "title": "Lease Generation",
            "type": "integer"
          }
        },
        "required": [
          "principal_id",
          "run_id",
          "group_id",
          "connection_id",
          "configuration",
          "lease_generation"
        ],
        "title": "ExecutionContext",
        "type": "object"
      },
      "ProfileSettings": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Name",
            "type": "string"
          },
          "origins": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Origins",
            "type": "array"
          }
        },
        "required": [
          "name",
          "origins"
        ],
        "title": "ProfileSettings",
        "type": "object"
      },
      "ProxySettings": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "direct",
            "enum": [
              "direct",
              "operator_default",
              "custom"
            ],
            "title": "Mode",
            "type": "string"
          },
          "server": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Server"
          },
          "auth": {
            "default": "none",
            "enum": [
              "none",
              "basic"
            ],
            "title": "Auth",
            "type": "string"
          }
        },
        "title": "ProxySettings",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1,
        "default": 1,
        "title": "Version",
        "type": "integer"
      },
      "context": {
        "$ref": "#/$defs/ExecutionContext"
      },
      "settings": {
        "$ref": "#/$defs/BrowserSettings"
      },
      "session_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Session Id",
        "type": "string"
      },
      "generation": {
        "default": 1,
        "minimum": 1,
        "title": "Generation",
        "type": "integer"
      }
    },
    "required": [
      "context",
      "settings",
      "session_id"
    ],
    "title": "WorkerOpen",
    "type": "object"
  },
