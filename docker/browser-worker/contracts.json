  "WorkerResult": {
    "$defs": {
      "Observation": {
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Observation Id",
            "type": "string"
          },
          "page_generation": {
            "minimum": 1,
            "title": "Page Generation",
            "type": "integer"
          },
          "origin": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Origin",
            "type": "string"
          },
          "text": {
            "default": "",
            "maxLength": 16000,
            "title": "Text",
            "type": "string"
          },
          "elements": {
            "items": {
              "$ref": "#/$defs/ObservedElement"
            },
            "maxItems": 200,
            "title": "Elements",
            "type": "array"
          }
        },
        "required": [
          "observation_id",
          "page_generation",
          "origin"
        ],
        "title": "Observation",
        "type": "object"
      },
      "ObservedElement": {
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Element Id",
            "type": "string"
          },
          "role": {
            "maxLength": 80,
            "title": "Role",
            "type": "string"
          },
          "text": {
            "maxLength": 1000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "element_id",
          "role",
          "text"
        ],
        "title": "ObservedElement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1,
        "default": 1,
        "title": "Version",
        "type": "integer"
      },
      "command_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Command Id",
        "type": "string"
      },
      "generation": {
        "minimum": 1,
        "title": "Generation",
        "type": "integer"
      },
      "sequence": {
        "minimum": 0,
        "title": "Sequence",
        "type": "integer"
      },
      "status": {
        "enum": [
          "confirmed",
          "failed_before_effect",
          "unknown",
          "approval_required",
          "challenge_required",
          "expired",
          "session_lost",
          "stale_observation",
          "policy_denied",
          "cancelled"
        ],
        "title": "Status",
        "type": "string"
      },
      "elapsed_ms": {
        "maximum": 60000,
        "minimum": 0,
        "title": "Elapsed Ms",
        "type": "integer"
      },
      "observation": {
        "anyOf": [
          {
            "$ref": "#/$defs/Observation"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "extracted": {
        "anyOf": [
          {
            "maxProperties": 20,
            "patternProperties": {
              "^[A-Za-z0-9_.:-]+$": {
                "maxLength": 4000,
                "type": "string"
              }
            },
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Extracted"
      },
      "artifact_id": {
        "anyOf": [
          {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Artifact Id"
      }
    },
    "required": [
      "command_id",
      "generation",
      "sequence",
      "status",
      "elapsed_ms"
    ],
    "title": "WorkerResult",
    "type": "object"
  }
}
