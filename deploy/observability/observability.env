# Extra settings for the observability profile. Use with your .env:
#   docker compose --env-file .env --env-file deploy/observability/observability.env --profile observability up --build
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
STUDIO_OTEL_METRICS=1
# HTTP, SQL and Redis spans in Jaeger, and JSON logs with request, run and trace ids
STUDIO_OTEL_INSTRUMENT=1
STUDIO_LOG_FORMAT=json
OTEL_METRIC_EXPORT_INTERVAL=15000
STUDIO_TRACE_URL=http://localhost:16686/trace/{trace_id}
STUDIO_GRAFANA_URL=http://localhost:3000
