# Rendered by the nginx image's envsubst step (API_UPSTREAM, default api:8000; WEB_MAX_BODY_SIZE, default 110m).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  root /usr/share/nginx/html;
  # Above every upload ceiling the api enforces itself (chat files STUDIO_CHAT_ATTACHMENT_MAX_MB, workflow zips 50 MB),
  # so the api answers with its own error code; raise WEB_MAX_BODY_SIZE with a ceiling above 100 MB (TASK-0203).
  client_max_body_size ${WEB_MAX_BODY_SIZE};
  error_page 413 = @too_large;
  location @too_large {
    default_type application/json;
    return 413 '{"success":false,"data":null,"error":{"code":"PAYLOAD_TOO_LARGE","message":"Payload too large","details":null}}';
  }

  location = /healthz { access_log off; return 200 "ok\n"; }

  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    # This nginx is the edge: it replaces X-Forwarded-For with the peer it sees, so a client cannot inject hops that the
    # api's STUDIO_TRUSTED_PROXIES (Compose: private ranges) would skip. Behind a load balancer, append instead
    # ($proxy_add_x_forwarded_for) and narrow STUDIO_TRUSTED_PROXIES to nginx + the balancer.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  location = /mcp {  # MCP server for workflow tokens (TASK-0114): Streamable HTTP, JSON responses
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  location /ws/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }

  # Frames (TASK-0143, DEC-0067): a published chat page may be framed by the sites in its embed_origins, which the api
  # gives as a Content-Security-Policy; every other page refuses frames. add_header is not inherited by locations that
  # set their own, so each HTML location sets it.
  location ~ ^/c/[a-z0-9-]+/?$ {
    auth_request /_chat_frame;
    auth_request_set $chat_frame $upstream_http_content_security_policy;
    add_header Content-Security-Policy $chat_frame always;
    try_files /index.html =404;
  }
  location = /_chat_frame {
    internal;
    rewrite ^ /api/public/chat-frame break;
    proxy_pass http://${API_UPSTREAM};
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Original-URI $request_uri;
  }
  location = /c/widget.js { add_header Cache-Control "no-cache"; try_files $uri =404; }  # the embed widget: a stable URL, so no long cache
  location / {  # SPA routes
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    try_files $uri /index.html;
  }
}
