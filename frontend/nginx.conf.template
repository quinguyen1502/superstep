# Rendered by the nginx image's envsubst step (API_UPSTREAM, default api:8000).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size 10m;

  location = /healthz { access_log off; return 200 "ok\n"; }

  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    # This nginx is the edge: it replaces X-Forwarded-For with the peer it sees, so a client cannot inject hops that the
    # api's STUDIO_TRUSTED_PROXIES (Compose: private ranges) would skip. Behind a load balancer, append instead
    # ($proxy_add_x_forwarded_for) and narrow STUDIO_TRUSTED_PROXIES to nginx + the balancer.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  location = /mcp {  # MCP server for workflow tokens (TASK-0114): Streamable HTTP, JSON responses
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  location /ws/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
  location / { try_files $uri /index.html; }  # SPA routes
}
