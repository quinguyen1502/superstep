# Copy to .env (never commit .env). Used by `docker compose up` and read by the backend in dev.

# --- secrets (required for docker compose) ---
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
# Fernet key for stored LLM credentials; empty = generated once into the api volume (/data/secret.key)
STUDIO_SECRET_KEY=

# --- database / redis ---
POSTGRES_USER=studio
POSTGRES_DB=studio
# Local dev without compose: leave DATABASE_URL empty for SQLite (backend/studio.db), or e.g.
# DATABASE_URL=postgresql://studio:change-me@localhost:5432/studio
# REDIS_URL empty = in-memory run bus (single process); e.g. REDIS_URL=redis://localhost:6379/0

# --- app ---
# production = refuse the placeholder JWT_SECRET and an empty STUDIO_SECRET_KEY (unless /data/secret.key already exists);
# no demo user. The first STUDIO_ADMIN_EMAILS account is then created at start-up with STUDIO_ADMIN_PASSWORD, or a
# generated password printed once in the log. PaaS deploys: docs/deploy/README.md
STUDIO_ENV=dev
STUDIO_ADMIN_PASSWORD=
WEB_PORT=8080
STUDIO_RUN_TIMEOUT=120
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Decision nodes (TASK-0050): TypeSafe Jev key used when a node has no credential; empty = offline sample answers
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
# Send email nodes (TASK-0051) use SMTP credentials. Private/loopback SMTP hosts (Mailpit, MailHog) need this set to 1.
STUDIO_SMTP_ALLOW_PRIVATE=0
# Recipients a workflow owner's Send email nodes may reach per hour
STUDIO_EMAIL_NODE_HOURLY_LIMIT=100
# MCP servers (TASK-0013): stdio servers run commands inside the api container (admins only); keep 0 unless you trust the commands
STUDIO_MCP_STDIO=0
# Repo import (TASK-0015) is experimental. 0 = /api/import* is 404 and the Import button stays hidden.
# 1 = pip install, inspect and run inside Docker. Leave STUDIO_IMPORT_RUNTIME unset in deployment.
# subprocess is the test escape hatch and is not a sandbox.
STUDIO_ENABLE_IMPORT=0
# Absolute host path of the import directory when the API runs under Compose. Must match the bind mount.
# STUDIO_IMPORT_HOST_DIR=
# STUDIO_IMPORT_IMAGE=python:3.12-slim
# STUDIO_IMPORT_MEMORY=1g
# STUDIO_IMPORT_CPUS=1
# STUDIO_IMPORT_PIDS=256
# STUDIO_IMPORT_NETWORK=bridge
# STUDIO_IMPORT_MAX_AGE_HOURS=72
# STUDIO_IMPORT_MAX_BYTES=209715200
# Tool nodes in Code mode (TASK-0053). 1 = main(state) runs in Docker with no network, no mounts and no server env.
# Build the image first: docker build -t studio-code:1 docker/studio-code
STUDIO_ENABLE_CODE_NODES=0
# docker (default), subprocess or remote. subprocess runs code on this host WITHOUT isolation (network, files); trusted
# local use only. remote = the sandbox service (docs/deploy/sandbox.md): set its URL and a shared token (16+ characters);
# `docker compose --profile sandbox up` starts it on an internal network.
# STUDIO_CODE_RUNTIME=docker
# STUDIO_SANDBOX_URL=http://sandbox:8080
# STUDIO_SANDBOX_TOKEN=
# STUDIO_CODE_IMAGE=studio-code:1
# STUDIO_CODE_MEMORY=256m
# STUDIO_CODE_CPUS=0.5
# STUDIO_CODE_PIDS=64
# STUDIO_CODE_MAX_SECONDS=30
# STUDIO_CODE_CONCURRENCY=4
# Extra env names copied into the sandbox, comma-separated, in addition to keys the repo declares.
# STUDIO_IMPORT_SECRETS=
# Group id of the Docker socket so the api user can open it (Linux: stat -c %g /var/run/docker.sock).
# STUDIO_DOCKER_GID=
# 1 = allow HTTP MCP servers on private/loopback addresses (e.g. a sidecar container)
STUDIO_MCP_ALLOW_PRIVATE=0
# HTTP Tool nodes: allow loopback/private targets (default 0) and the per-request timeout in seconds (TASK-0039)
STUDIO_HTTP_TOOL_ALLOW_PRIVATE=0
STUDIO_HTTP_TOOL_TIMEOUT=30
# Allowed browser origins, comma-separated. Unset: * in dev, none in production (the UI is served from the same origin)
# STUDIO_CORS_ORIGINS=https://studio.example.com

# --- tracing (TASK-0010); all empty = tracing off (no-op) ---
# OpenTelemetry OTLP/HTTP, standard OTEL_* variables. With `docker compose --profile tracing up`:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#   STUDIO_TRACE_URL=http://localhost:16686/trace/{trace_id}
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=superstep
# Link template shown in the run timeline/history ({trace_id} is replaced)
STUDIO_TRACE_URL=
# LangSmith (optional): exported over its OTLP endpoint only when both are set
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# --- API triggers (TASK-0007) ---
# Run queued API jobs inside the API process (1, default) or only in `python -m app.worker` (0; needs REDIS_URL)
STUDIO_WORKER=1
STUDIO_WORKER_CONCURRENCY=2
# Allow result webhooks to private / loopback addresses (SSRF guard; keep 0 in production)
STUDIO_ALLOW_PRIVATE_CALLBACKS=0

# --- phase-2 hardening (TASK-0019) ---
# Human-in-the-loop: waiting runs expire after this many seconds (0 = never). Default 7 days.
STUDIO_WAIT_TTL=604800
# API triggers: runs per token per window (0 = off); sync mode waits at most this long, then 202 + poll_url.
STUDIO_TRIGGER_RATE_LIMIT=60
STUDIO_TRIGGER_RATE_WINDOW=60
# Chat triggers (TASK-0075): runs per sender and chat trigger per STUDIO_TRIGGER_RATE_WINDOW (0 = off).
STUDIO_CHAT_TRIGGER_RATE_LIMIT=60
STUDIO_SYNC_WAIT_MAX=30
# Workflow versions: keep the newest N (0 = keep all). Versions used by runs are never deleted.
STUDIO_VERSION_KEEP=0
# LLM price overrides, USD per 1M tokens {"model-prefix": [input, output]}. STUDIO_PRICES wins over the file.
STUDIO_PRICES=
STUDIO_PRICES_FILE=

# --- deferred hardening (TASK-0020) ---
# Public base URL used for links in notification e-mails / webhooks (e.g. https://studio.example.com)
STUDIO_PUBLIC_URL=
# E-mail notification when a run waits for a human. Unset SMTP_HOST = no e-mail (in-app bell only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=studio@localhost
SMTP_STARTTLS=1
SMTP_SSL=0
# Optional generic notify webhook (JSON POST per waiting/expired run), HMAC-signed when the secret is set.
STUDIO_NOTIFY_WEBHOOK_URL=
STUDIO_NOTIFY_WEBHOOK_SECRET=
# Result-webhook deliveries: attempts, exponential backoff base/max (seconds).
STUDIO_WEBHOOK_MAX_ATTEMPTS=5
STUDIO_WEBHOOK_BACKOFF_BASE=2
STUDIO_WEBHOOK_BACKOFF_MAX=300
# After rotating a signing secret the previous one stays valid this many seconds.
STUDIO_SECRET_GRACE=86400
# Redis queue: job lease (visibility timeout) and stale-job reaper interval, seconds.
STUDIO_JOB_VISIBILITY_TIMEOUT=30
STUDIO_JOB_REAP_EVERY=15
# Export OTel metrics (runs, duration, tokens, cost, errors) over OTLP; needs OTEL_EXPORTER_OTLP_ENDPOINT.
STUDIO_OTEL_METRICS=0

# --- effectively-once + live notifications (TASK-0021) ---
# No new settings: idempotency keys, the node ledger and fencing are always on; live push uses REDIS_URL when set.

# --- approval through Slack / Telegram / WhatsApp, and e-mail / Teams links (TASK-0022, TASK-0047) ---
# Callbacks need the public https STUDIO_PUBLIC_URL above. Buttons expire after STUDIO_APPROVAL_TTL seconds.
STUDIO_APPROVAL_TTL=86400
# WhatsApp Cloud API base (tests point it at a fake). E-mail and Teams approvals need STUDIO_PUBLIC_URL; e-mail needs SMTP_HOST.
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Bootstrap admins (TASK-0014): these e-mails become admin at sign-up, and at start-up only while no active admin exists
# (lockout recovery). Roles are otherwise managed in Settings -> Users.
STUDIO_ADMIN_EMAILS=
# Role of newly registered accounts: editor (default) or viewer.
STUDIO_DEFAULT_ROLE=editor
# Sign-in hardening (TASK-0045). Failed sign-ins per e-mail before a lockout, the window they count in, and the lock (seconds).
STUDIO_LOGIN_MAX_FAILURES=5
STUDIO_LOGIN_WINDOW=900
STUDIO_LOGIN_LOCK=900
# A password reset link works once for this many seconds. Self-service reset e-mail needs SMTP_HOST and STUDIO_PUBLIC_URL.
STUDIO_PASSWORD_RESET_TTL=3600
# The session cookie is Secure in production. Set 0 only for a production deployment served over plain HTTP.
# STUDIO_COOKIE_SECURE=1
# "Add to Slack" (OAuth distribution of one Slack app to many workspaces, TASK-0014). Needs STUDIO_PUBLIC_URL; redirect URL
# {STUDIO_PUBLIC_URL}/api/approvals/slack/oauth/callback. Leave empty to keep pasting bot tokens only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Per-window (60 s) limits of the public callback endpoints: per client IP and per connection / Slack workspace.
# Client IP for the limits: X-Forwarded-For is read right to left, skipping these trusted proxy CIDRs; only used
# when the direct peer is one of them. Empty = use the peer address. STUDIO_TRUST_PROXY=1 (older) trusts one hop.
STUDIO_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
STUDIO_CALLBACK_RATE_LIMIT_IP=60
STUDIO_CALLBACK_RATE_LIMIT_CHANNEL=300

# Chat attachment storage (TASK-0192, REQ-0080, DEC-0074): db (default, in the database), fs (a folder) or s3.
# fs keeps files under STUDIO_ATTACHMENT_FS_PATH; in docker compose that is the apidata volume shared by api and worker.
# STUDIO_ATTACHMENT_STORAGE=db
# STUDIO_ATTACHMENT_FS_PATH=/data/attachments
# s3 (TASK-0193) works with AWS S3, Cloudflare R2, Backblaze B2 and MinIO. Keys left empty use the default AWS chain.
# STUDIO_ATTACHMENT_S3_BUCKET=
# STUDIO_ATTACHMENT_S3_PREFIX=
# STUDIO_ATTACHMENT_S3_ENDPOINT=
# STUDIO_ATTACHMENT_S3_REGION=
# STUDIO_ATTACHMENT_S3_PATH_STYLE=false
# Files above this many MB go up in parts (min 5); a failed upload is aborted.
# STUDIO_ATTACHMENT_S3_MULTIPART_MB=8
# STUDIO_ATTACHMENT_S3_ACCESS_KEY_ID=
# STUDIO_ATTACHMENT_S3_SECRET_ACCESS_KEY=
