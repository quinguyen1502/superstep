{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superstep.dev/schemas/chat-ws/v1/server.json",
  "title": "Chat socket v1: server frame",
  "description": "A frame the server sends on /ws/public/v1/chat/{slug}. Every frame has `v` (1) and `seq` (0, 1, 2... per connection). Clients must ignore fields and frame types they do not know: v1 only grows.",
  "oneOf": [
    {"$ref": "#/$defs/ready"},
    {"$ref": "#/$defs/run_started"},
    {"$ref": "#/$defs/token"},
    {"$ref": "#/$defs/step"},
    {"$ref": "#/$defs/question"},
    {"$ref": "#/$defs/turn"},
    {"$ref": "#/$defs/done"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["type", "v", "seq"],
      "properties": {
        "v": {"const": 1},
        "seq": {"type": "integer", "minimum": 0},
        "ts": {"type": ["number", "null"], "description": "Unix time (seconds) of the run event."}
      }
    },
    "ready": {
      "description": "Sent once the socket is open: send `auth` (optional), then a `message` or an `answer`.",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {"type": {"const": "ready"}, "protocol": {"const": "superstep-chat"}},
      "required": ["protocol"]
    },
    "run_started": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {"type": {"const": "run_started"}, "run_id": {"type": "string"}},
      "required": ["run_id"]
    },
    "token": {
      "description": "A piece of the answer as the model writes it (`node_token` on the unversioned socket).",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {
        "type": {"const": "token"},
        "node": {"type": ["string", "null"]},
        "field": {"type": ["string", "null"]},
        "iteration": {"type": ["integer", "null"]},
        "delta": {"type": "string"}
      },
      "required": ["delta"]
    },
    "step": {
      "description": "A node started, finished or failed, as much as the chat's steps mode shows.",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {
        "type": {"const": "step"},
        "event": {"enum": ["started", "finished", "error"]},
        "node": {"type": "string"},
        "label": {"type": ["string", "null"]},
        "node_type": {"type": ["string", "null"]},
        "iteration": {"type": ["integer", "null"]},
        "status": {"type": "string"},
        "duration_ms": {"type": ["number", "null"]},
        "code": {"type": ["string", "null"]}
      },
      "required": ["event", "node"]
    },
    "question": {
      "description": "The run waits at a Human node: show `prompt` (and `fields` or `options`), then answer on a new socket.",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {
        "type": {"const": "question"},
        "node": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "prompt": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "input_type": {"type": ["string", "null"]},
        "placeholder": {"type": ["string", "null"]},
        "options": {"type": ["array", "null"]},
        "choices": {"type": ["array", "null"]},
        "fields": {"type": ["array", "null"]}
      }
    },
    "turn": {
      "description": "The stored answer turn (rate it with its id), sent just before `done` when it is saved in time.",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {
        "type": {"const": "turn"},
        "turn_id": {"type": "string"},
        "role": {"const": "assistant"},
        "status": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]}
      },
      "required": ["turn_id", "role"]
    },
    "done": {
      "description": "The run ended (or paused at a question: `waiting`). The server then closes the socket.",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {
        "type": {"const": "done"},
        "run_id": {"type": ["string", "null"]},
        "status": {"enum": ["ok", "error", "waiting", "cancelled", "timeout"]}
      },
      "required": ["status"]
    },
    "error": {
      "description": "The message could not run, or the run failed. `error` is the envelope's error object; the code is the contract (docs/api-errors.md).",
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {
        "type": {"const": "error"},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {}}
        }
      },
      "required": ["error"]
    }
  }
}
