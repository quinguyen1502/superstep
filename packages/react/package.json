{
  "name": "@superstep/react",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinguyen1502/superstep.git",
    "directory": "packages/react"
  },
  "description": "React chat hook, components and scoped themes shared with Superstep Studio.",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui/*": {
      "source": "./src/ui/*.tsx",
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./chat": {
      "source": "./src/lib/chat.ts",
      "types": "./dist/lib/chat.d.ts",
      "import": "./dist/lib/chat.js"
    },
    "./errors": {
      "source": "./src/lib/errors.ts",
      "types": "./dist/lib/errors.d.ts",
      "import": "./dist/lib/errors.js"
    },
    "./files": {
      "source": "./src/lib/files.ts",
      "types": "./dist/lib/files.d.ts",
      "import": "./dist/lib/files.js"
    },
    "./highlighter": {
      "source": "./src/lib/highlighter.tsx",
      "types": "./dist/lib/highlighter.d.ts",
      "import": "./dist/lib/highlighter.js"
    },
    "./format": {
      "source": "./src/lib/format.ts",
      "types": "./dist/lib/format.d.ts",
      "import": "./dist/lib/format.js"
    },
    "./node-icons": {
      "source": "./src/lib/node-icons.ts",
      "types": "./dist/lib/node-icons.d.ts",
      "import": "./dist/lib/node-icons.js"
    },
    "./use-highlighted-code": {
      "source": "./src/hooks/use-highlighted-code.ts",
      "types": "./dist/hooks/use-highlighted-code.d.ts",
      "import": "./dist/hooks/use-highlighted-code.js"
    },
    "./styles.css": "./dist/styles.css",
    "./confirm-delete-dialog": {
      "source": "./src/components/confirm-delete-dialog.tsx",
      "types": "./dist/components/confirm-delete-dialog.d.ts",
      "import": "./dist/components/confirm-delete-dialog.js"
    },
    "./use-confirm-delete": {
      "source": "./src/components/use-confirm-delete.tsx",
      "types": "./dist/components/use-confirm-delete.d.ts",
      "import": "./dist/components/use-confirm-delete.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@superstep/sdk",
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json",
    "lint": "oxlint src",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@superstep/sdk": "^0.2.0",
    "react": ">=18",
    "react-dom": ">=18",
    "i18next": ">=25",
    "react-i18next": ">=15"
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7",
    "oxlint": "^1.81.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "29.1.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "tw-animate-css": "1.4.0",
    "shadcn": "^4.21.5"
  }
}
