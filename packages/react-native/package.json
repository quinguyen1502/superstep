{
  "name": "@superstep/react-native",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React Native chat components for the Superstep public chat API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinguyen1502/superstep.git",
    "directory": "packages/react-native"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --prefix ../../sdk/typescript",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@superstep/sdk": "^0.2.0",
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "0.76.9",
    "@superstep/sdk": "file:../../sdk/typescript",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.6.3"
  }
}
